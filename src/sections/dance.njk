<div class="project-detail dance-stage">
  <div class="dance-screen" id="dance-screen">
    <video id="dance-player" playsinline preload="auto"></video>
  </div>
  <div class="dance-controls">
    <button type="button" id="dance-toggle" aria-label="Play">&#x25B6;&#xFE0E;</button>
    <button type="button" id="dance-next" aria-label="Next clip">&#x23ED;&#xFE0E;</button>
    <button type="button" id="dance-mute" aria-label="Unmute">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 9h4l5-4v14l-5-4H3z" fill="currentColor"/><g class="icon-off" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M16 9l5 6M21 9l-5 6"/></g><g class="icon-on" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M15.5 9a4 4 0 0 1 0 6M18.5 6a8 8 0 0 1 0 12"/></g></svg>
    </button>
  </div>
  <!-- <div class="detail-meta">
    <p>Click a thumbnail to play. Click the video to pause or resume.</p>
  </div> -->
</div>

<div class="dance-grid">
{%- for clip in danceClips %}
  <button type="button" class="dance-thumb{% if loop.first %} active{% endif %}" data-src="{{ media.url }}/videos/dance/{{ clip }}.mp4" aria-label="Play clip {{ loop.index }}">
    <img src="/assets/images/dance/{{ clip }}.png" alt="" width="60" height="60" loading="lazy">
  </button>
{%- endfor %}
</div>

<script>
(function () {
  var player = document.getElementById('dance-player');
  var grid = document.querySelector('.dance-grid');
  var thumbs = Array.prototype.slice.call(document.querySelectorAll('.dance-thumb'));
  var current = 0;

  for (var i = thumbs.length - 1; i > 0; i--) {
    var j = Math.floor(Math.random() * (i + 1));
    var tmp = thumbs[i]; thumbs[i] = thumbs[j]; thumbs[j] = tmp;
  }
  thumbs.forEach(function (b) { grid.appendChild(b); });
  thumbs.forEach(function (b, i) { b.classList.toggle('active', i === 0); });
  player.src = thumbs[0].dataset.src;

  function play(index) {
    current = (index + thumbs.length) % thumbs.length;
    var t = thumbs[current];
    thumbs.forEach(function (b) { b.classList.toggle('active', b === t); });
    player.src = t.dataset.src;
    var p = player.play();
    if (p) p.catch(function () {});
    if (grid.scrollWidth > grid.clientWidth) {
      grid.scrollTo({ left: t.offsetLeft - (grid.clientWidth - t.offsetWidth) / 2, behavior: 'smooth' });
    }
  }

  thumbs.forEach(function (b, i) {
    b.addEventListener('click', function () { unmute(); play(i); });
  });
  player.addEventListener('ended', function () { play(current + 1); });
  var toggle = document.getElementById('dance-toggle');
  function togglePlay() { player.paused ? player.play() : player.pause(); }
  function syncToggle() {
    toggle.innerHTML = player.paused ? '&#x25B6;&#xFE0E;' : '&#x23F8;&#xFE0E;';
    toggle.setAttribute('aria-label', player.paused ? 'Play' : 'Pause');
  }
  // Browsers only allow muted autoplay, so the first interaction turns the sound on.
  function unmute() {
    if (!player.muted) return false;
    player.muted = false;
    return true;
  }
  document.getElementById('dance-screen').addEventListener('click', function () {
    if (unmute() && !player.paused) return;
    togglePlay();
  });
  toggle.addEventListener('click', function () { unmute(); togglePlay(); });
  player.addEventListener('play', syncToggle);
  player.addEventListener('pause', syncToggle);
  document.getElementById('dance-next').addEventListener('click', function () {
    unmute();
    var next = Math.floor(Math.random() * (thumbs.length - 1));
    play(next >= current ? next + 1 : next);
  });

  var muteBtn = document.getElementById('dance-mute');
  function syncMute() {
    muteBtn.classList.toggle('is-muted', player.muted);
    muteBtn.setAttribute('aria-label', player.muted ? 'Unmute' : 'Mute');
  }
  muteBtn.addEventListener('click', function () { player.muted = !player.muted; });
  player.addEventListener('volumechange', syncMute);
  syncMute();

  var autoplay = player.play();
  if (autoplay) autoplay.catch(function () {
    player.muted = true;
    player.play().catch(function () {});
  });
})();
</script>
