<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ title }}</title>
    <link rel="stylesheet" href="/style.css">
   <link href="/vendor/lightbox2/css/lightbox.min.css" rel="stylesheet">
<script src="/vendor/jquery/jquery.min.js"></script>
<script src="/vendor/lightbox2/js/lightbox.min.js"></script>
<body>
    <div class = "container">
        <div class="content">
            {% include "_header.njk" %}
                <h1>{{ title}}</h1>
                 {{ content | safe }}
             
            {% if photos %}
              <div class="project-photos">
                {% for photo in photos %}
                  <a href="{{ photo.src }}" data-lightbox="project-gallery">
                    <img src="{{ photo.src }}" alt="{{ photo.alt or title }}" />
                  </a>
                {% endfor %}
              </div>
            {% endif %}
            </div>
    </div>
</body>
</html>
